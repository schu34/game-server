{
  "name": "games-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch apps/dev-server/src/main.ts",
    "dev:web": "pnpm --filter @gs/tic-tac-toe-web dev",
    "start": "node apps/dev-server/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/tic-tac-toe-web/tsconfig.json",
    "test": "LOG_LEVEL=silent node --test 'packages/*/test/**/*.test.ts' 'games/*/test/**/*.test.ts' 'apps/*/test/**/*.test.ts'",
    "demo": "node games/tic-tac-toe/cli/play.ts",
    "demo:undercut": "node games/undercut/cli/play.ts",
    "bench": "node apps/dev-server/bench/load.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.17.0"
}
