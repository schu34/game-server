{
  "name": "games-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch apps/dev-server/src/main.ts",
    "start": "node apps/dev-server/src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'packages/*/test/**/*.test.ts' 'games/*/test/**/*.test.ts' 'apps/*/test/**/*.test.ts'",
    "demo": "node games/tic-tac-toe/cli/play.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.17.0"
}
